# ==============================================================================
# Bachelor's Hub Technologies (BHT) - Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bht_db
DB_CONNECTION_LIMIT=10

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# Email Notification Configuration (Nodemailer & SMTP)
# ==============================================================================
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste your email as SMTP_USER and the 16-char App Password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
# Optional sender name
SMTP_FROM="Bachelor's Hub Technologies" <your_email@gmail.com>
# The recipient address where all admission enquiry notifications are delivered
NOTIFICATION_RECIPIENT_EMAIL=bht.enquiry123@gmail.com

# ==============================================================================
# Authentication & JWT Security
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Administrator Account (Initialized securely using bcrypt on first startup)
DEFAULT_ADMIN_NAME="BHT Administrator"
DEFAULT_ADMIN_EMAIL=bht.enquiry123@gmail.com
DEFAULT_ADMIN_PASSWORD=bht@1234

